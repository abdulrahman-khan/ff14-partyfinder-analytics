config {
  type: "table",
  schema: "gold",
  name: "mart_prog_vs_clear",
  description: "Fill dynamics split by RAIDER INTENT: progression ('[Practice]') vs clear/reclear ('[Duty Complete]', i.e. the party requires an existing clear) vs unspecified, by duty x region. Prog groups and farm parties behave nothing alike - this quantifies how much slower a fresh-prog party fills than a reclear. Intent is derived from description tags carried on fct_listing_lifecycle (is_practice / is_duty_complete, MAX over the session). NOTE: the raw '[clear]' tag does not exist in xivpf data (~18 rows of 1.8M), so 'Duty Complete' is the correct reclear proxy. Tags are most meaningful on high-end content; dashboards typically filter is_high_end = 1. Percentiles are over filled sessions only; fill_rate_pct excludes single-snapshot 'flash' sessions. Maps to grouped bars (prog vs clear) per duty.",
  bigquery: {
    clusterBy: ["pf_region", "content_category"]
  },
  assertions: {
    nonNull: ["pf_region", "duty", "intent"],
    rowConditions: [
      "sessions > 0",
      "intent IN ('prog', 'clear', 'unspecified')",
      "fill_rate_pct IS NULL OR fill_rate_pct BETWEEN 0 AND 100",
      "median_time_to_fill_min IS NULL OR median_time_to_fill_min >= 0"
    ]
  },
  columns: {
    pf_region: "Region the listing was posted in",
    duty: "Duty name",
    content_category: "savage / ultimate / extreme / unreal / alliance / chaotic / other",
    is_high_end: "1 if high-end content",
    intent: "prog (is_practice) / clear (is_duty_complete, no practice) / unspecified",
    sessions: "Listing sessions for this duty/region/intent",
    sessions_resolved: "Resolved sessions (filled + expired_partial); excludes flash and still-live",
    sessions_filled: "Sessions inferred to have filled (delisted from one short of full)",
    fill_rate_pct: "sessions_filled / sessions_resolved * 100",
    median_time_to_fill_min: "Median minutes from post to full, over filled sessions (APPROX p50)",
    p90_time_to_fill_min: "90th percentile minutes to full, over filled sessions",
    avg_time_to_fill_min: "Mean minutes to full, over filled sessions"
  }
}

WITH base AS (
  SELECT
    l.pf_region,
    d.duty,
    l.content_category,
    l.is_high_end,
    CASE
      WHEN l.is_practice = 1 THEN 'prog'
      WHEN l.is_duty_complete = 1 THEN 'clear'
      ELSE 'unspecified'
    END AS intent,
    l.outcome,
    l.reached_full,
    IF(l.reached_full = 1, l.time_to_full_min, NULL) AS ttf
  FROM ${ref("fct_listing_lifecycle")} l
  LEFT JOIN ${ref("dim_duties")} d ON d.duty_key = l.duty_key
  WHERE l.pf_region IS NOT NULL
)

SELECT
  pf_region,
  duty,
  content_category,
  is_high_end,
  intent,
  COUNT(*) AS sessions,
  COUNTIF(outcome IN ('filled', 'expired_partial')) AS sessions_resolved,
  COUNTIF(reached_full = 1) AS sessions_filled,
  ROUND(SAFE_DIVIDE(COUNTIF(reached_full = 1), COUNTIF(outcome IN ('filled', 'expired_partial'))) * 100, 1) AS fill_rate_pct,
  APPROX_QUANTILES(ttf, 100)[OFFSET(50)] AS median_time_to_fill_min,
  APPROX_QUANTILES(ttf, 100)[OFFSET(90)] AS p90_time_to_fill_min,
  ROUND(AVG(ttf), 1) AS avg_time_to_fill_min
FROM base
GROUP BY 1, 2, 3, 4, 5
