config {
  type: "table",
  schema: "gold",
  tags: ["gold"],
  name: "mart_ilvl_gating",
  description: "GEAR-GATE TREND MART. Tracks how the minimum item-level gate on listings evolves over time and correlates with fill speed. Grain: duty × region × datacenter × reset_week. Sourced from fct_listing_lifecycle (one row per session). Reports avg/min/p90 ilvl per week, plus fill_rate_pct and median time-to-fill from the same week. Answers 'does this duty's ilvl requirement ease off as the tier ages, and do over-geared listings fill faster?' - a real prog-community question. Maps to a line chart (ilvl trend) overlaid with fill rate on a secondary axis.",
  bigquery: {
    clusterBy: ["pf_region", "pf_datacenter"]
  },
  assertions: {
    nonNull: ["pf_region", "pf_datacenter", "duty", "reset_week"],
    rowConditions: [
      "sessions > 0",
      "avg_ilvl >= 0",
      "fill_rate_pct IS NULL OR fill_rate_pct BETWEEN 0 AND 100"
    ]
  },
  columns: {
    pf_region: "Region the listing was posted in",
    pf_datacenter: "Datacenter the listing was posted on",
    duty: "Duty name",
    content_category: "savage / ultimate / extreme / unreal / alliance / chaotic / other",
    reset_week: "FFXIV reset week (Tuesday 08:00 UTC)",
    sessions: "Total listing sessions in this bucket",
    avg_ilvl: "Average min_ilvl across sessions",
    min_ilvl: "Minimum min_ilvl seen (floor gate)",
    p50_ilvl: "Median min_ilvl",
    p90_ilvl: "90th percentile min_ilvl",
    sessions_filled: "Sessions inferred to have filled",
    fill_rate_pct: "sessions_filled / sessions * 100",
    median_time_to_fill_min: "Median minutes from post to full over filled sessions"
  }
}

SELECT
  l.pf_region,
  l.pf_datacenter,
  d.duty,
  l.content_category,
  dd.ffxiv_reset_week_start AS reset_week,
  COUNT(*) AS sessions,
  ROUND(AVG(l.min_ilvl), 0) AS avg_ilvl,
  MIN(l.min_ilvl) AS min_ilvl,
  APPROX_QUANTILES(l.min_ilvl, 100)[OFFSET(50)] AS p50_ilvl,
  APPROX_QUANTILES(l.min_ilvl, 100)[OFFSET(90)] AS p90_ilvl,
  COUNTIF(l.outcome = 'filled') AS sessions_filled,
  ROUND(COUNTIF(l.outcome = 'filled') * 100.0 / COUNT(*), 1) AS fill_rate_pct,
  APPROX_QUANTILES(NULLIF(l.time_to_full_min, 0), 100)[OFFSET(50)] AS median_time_to_fill_min
FROM ${ref("fct_listing_lifecycle")} l
LEFT JOIN ${ref("dim_duties")} d ON d.duty_key = l.duty_key
LEFT JOIN ${ref("dim_date")} dd ON dd.date = l.first_seen_date
WHERE l.pf_region IS NOT NULL
  AND l.min_ilvl IS NOT NULL
  AND l.slots_total <= 8
GROUP BY 1, 2, 3, 4, 5
