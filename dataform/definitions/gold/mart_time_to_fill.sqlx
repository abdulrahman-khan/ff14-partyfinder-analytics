config {
  type: "table",
  schema: "gold",
  tags: ["gold"],
  name: "mart_time_to_fill",
  description: "HERO PATTERN MART. Time-to-fill and fill rate by duty x region x datacenter x weekday x hour-of-day, bucketed on when the listing was POSTED (session_start). RECENT-WINDOW ONLY: restricted to the last PATTERN_WINDOW_WEEKS (8) reset weeks, anchored on the data frontier (max first_seen_date), so intraday post-timing patterns reflect the current tier instead of smearing across patch boundaries; window_start_date/window_end_date carry the bounds. For date-filterable patch-history trends use mart_duty_trends. Sourced from fct_listing_lifecycle. Fill is INFERRED from delisting (see fct_listing_lifecycle): a session last seen one short of full that then vanished is 'filled'. Percentiles are over filled sessions; fill_rate_pct is over RESOLVED sessions (filled + expired_partial) so single-snapshot 'flash' and still-'live' sessions are excluded. Maps to a weekday x hour heatmap.",
  bigquery: {
    clusterBy: ["pf_region", "pf_datacenter", "content_category"]
  },
  assertions: {
    nonNull: ["pf_region", "duty", "post_weekday", "post_hour"],
    rowConditions: [
      "sessions > 0",
      "fill_rate_pct IS NULL OR fill_rate_pct BETWEEN 0 AND 100",
      "median_time_to_fill_min IS NULL OR median_time_to_fill_min >= 0"
    ]
  },
  columns: {
    window_start_date: "Start of the recent pattern window (data frontier - PATTERN_WINDOW_WEEKS)",
    window_end_date: "End of the recent pattern window (data frontier = max first_seen_date)",
    pf_region: "Region the listing was posted in",
    pf_datacenter: "Datacenter the listing was posted on",
    duty: "Duty name",
    content_category: "savage / ultimate / extreme / unreal / alliance / chaotic / other",
    is_high_end: "1 if high-end content",
    post_weekday: "Day the listing was posted: 1=Sunday .. 7=Saturday",
    day_name: "Weekday label, e.g. Tuesday",
    is_weekend: "TRUE if posted on Sat/Sun",
    post_hour: "Hour of day (UTC) the listing was posted (0-23)",
    sessions: "Listing sessions posted in this bucket",
    sessions_resolved: "Resolved sessions (filled + expired_partial); excludes flash and still-live",
    sessions_filled: "Sessions inferred to have filled (delisted from one short of full)",
    fill_rate_pct: "sessions_filled / sessions_resolved * 100",
    median_time_to_fill_min: "Median minutes from post to full, over filled sessions (APPROX p50)",
    p90_time_to_fill_min: "90th percentile minutes to full, over filled sessions",
    avg_time_to_fill_min: "Mean minutes to full, over filled sessions",
    ttf_lt_15: "Filled sessions with time-to-fill < 15 minutes",
    ttf_15_30: "Filled sessions with time-to-fill 15-30 minutes",
    ttf_30_60: "Filled sessions with time-to-fill 30-60 minutes",
    ttf_60_120: "Filled sessions with time-to-fill 60-120 minutes",
    ttf_gt_120: "Filled sessions with time-to-fill > 120 minutes",
    censored_pct: "Share of sessions that are right-censored (live/flash) and excluded from ttf"
  }
}

WITH win AS (
  SELECT
    MAX(first_seen_date) AS window_end_date,
    DATE_SUB(MAX(first_seen_date), INTERVAL ${ffxiv.PATTERN_WINDOW_WEEKS} WEEK) AS window_start_date
  FROM ${ref("fct_listing_lifecycle")}
),

base AS (
  SELECT
    l.pf_region,
    l.pf_datacenter,
    l.duty_key,
    d.duty,
    l.content_category,
    l.is_high_end,
    EXTRACT(DAYOFWEEK FROM l.session_start) AS post_weekday,
    dd.day_name,
    dd.is_weekend,
    EXTRACT(HOUR FROM l.session_start) AS post_hour,
    l.reached_full,
    l.outcome,
    IF(l.reached_full = 1, l.time_to_full_min, NULL) AS ttf
  FROM ${ref("fct_listing_lifecycle")} l
  LEFT JOIN ${ref("dim_duties")} d ON d.duty_key = l.duty_key
  LEFT JOIN ${ref("dim_date")} dd ON dd.date = l.first_seen_date
  WHERE l.pf_region IS NOT NULL
    AND l.first_seen_date >= ${ffxiv.patternWindowCutoff(ref("fct_listing_lifecycle"))}
),

agg AS (
  SELECT
    pf_region,
    pf_datacenter,
    duty,
    content_category,
    is_high_end,
    post_weekday,
    day_name,
    is_weekend,
    post_hour,
    COUNT(*) AS sessions,
    COUNTIF(outcome IN ('filled', 'expired_partial')) AS sessions_resolved,
    COUNTIF(reached_full = 1) AS sessions_filled,
    ROUND(SAFE_DIVIDE(COUNTIF(reached_full = 1), COUNTIF(outcome IN ('filled', 'expired_partial'))) * 100, 1) AS fill_rate_pct,
    APPROX_QUANTILES(ttf, 100)[OFFSET(50)] AS median_time_to_fill_min,
    APPROX_QUANTILES(ttf, 100)[OFFSET(90)] AS p90_time_to_fill_min,
    ROUND(AVG(ttf), 1) AS avg_time_to_fill_min,
    COUNTIF(ttf IS NOT NULL AND ttf < 15) AS ttf_lt_15,
    COUNTIF(ttf IS NOT NULL AND ttf BETWEEN 15 AND 29) AS ttf_15_30,
    COUNTIF(ttf IS NOT NULL AND ttf BETWEEN 30 AND 59) AS ttf_30_60,
    COUNTIF(ttf IS NOT NULL AND ttf BETWEEN 60 AND 119) AS ttf_60_120,
    COUNTIF(ttf IS NOT NULL AND ttf >= 120) AS ttf_gt_120,
    ROUND(COUNTIF(outcome IN ('live', 'flash')) * 100.0 / COUNT(*), 1) AS censored_pct
  FROM base
  GROUP BY 1, 2, 3, 4, 5, 6, 7, 8, 9
)

SELECT agg.*, win.window_start_date, win.window_end_date
FROM agg CROSS JOIN win
