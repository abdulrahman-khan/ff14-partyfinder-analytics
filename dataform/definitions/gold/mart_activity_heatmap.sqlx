config {
  type: "table",
  schema: "gold",
  name: "mart_activity_heatmap",
  description: "PATTERN MART. Party Finder posting activity by region x datacenter x weekday x hour-of-day (UTC), bucketed on when listings were posted. Answers 'when is PF busiest on my DC'. RECENT-WINDOW ONLY: restricted to the last PATTERN_WINDOW_WEEKS (8) reset weeks, anchored on the data frontier (max first_seen_date), so the busy-hour pattern reflects the current tier instead of smearing across patches; window_start_date/window_end_date carry the bounds. For date-filterable weekly volume trends use mart_duty_trends. Sourced from fct_listing_lifecycle (one row per session), so it counts listings posted rather than raw scrape snapshots. Replaces mart_activity_hour_datacenter. Maps to a weekday x hour heatmap.",
  bigquery: {
    clusterBy: ["pf_region", "pf_datacenter"]
  },
  assertions: {
    nonNull: ["pf_region", "pf_datacenter", "post_weekday", "post_hour"],
    rowConditions: [
      "listings_posted > 0",
      "fill_rate_pct IS NULL OR fill_rate_pct BETWEEN 0 AND 100",
      "avg_lifetime_min IS NULL OR avg_lifetime_min >= 0"
    ]
  },
  columns: {
    window_start_date: "Start of the recent pattern window (data frontier - PATTERN_WINDOW_WEEKS)",
    window_end_date: "End of the recent pattern window (data frontier = max first_seen_date)",
    pf_region: "Region the listing was posted in",
    pf_datacenter: "Datacenter the listing was posted on",
    post_weekday: "Day posted: 1=Sunday .. 7=Saturday",
    day_name: "Weekday label, e.g. Tuesday",
    is_weekend: "TRUE if posted on Sat/Sun",
    post_hour: "Hour of day (UTC) the listing was posted (0-23)",
    listings_posted: "Listing sessions posted in this bucket",
    avg_lifetime_min: "Mean observed lifetime (minutes) of those sessions",
    fill_rate_pct: "Share of RESOLVED sessions (filled + expired_partial) that reached full; excludes flash and still-live"
  }
}

WITH win AS (
  SELECT
    MAX(first_seen_date) AS window_end_date,
    DATE_SUB(MAX(first_seen_date), INTERVAL ${ffxiv.PATTERN_WINDOW_WEEKS} WEEK) AS window_start_date
  FROM ${ref("fct_listing_lifecycle")}
),

agg AS (
  SELECT
    l.pf_region,
    l.pf_datacenter,
    EXTRACT(DAYOFWEEK FROM l.session_start) AS post_weekday,
    dd.day_name,
    dd.is_weekend,
    EXTRACT(HOUR FROM l.session_start) AS post_hour,
    COUNT(*) AS listings_posted,
    ROUND(AVG(l.observed_lifetime_min), 1) AS avg_lifetime_min,
    ROUND(SAFE_DIVIDE(COUNTIF(l.reached_full = 1), COUNTIF(l.outcome IN ('filled', 'expired_partial'))) * 100, 1) AS fill_rate_pct
  FROM ${ref("fct_listing_lifecycle")} l
  LEFT JOIN ${ref("dim_date")} dd ON dd.date = l.first_seen_date
  WHERE l.pf_region IS NOT NULL
    AND l.pf_datacenter IS NOT NULL
    AND l.first_seen_date >= ${ffxiv.patternWindowCutoff(ref("fct_listing_lifecycle"))}
  GROUP BY 1, 2, 3, 4, 5, 6
)

SELECT agg.*, win.window_start_date, win.window_end_date
FROM agg CROSS JOIN win
