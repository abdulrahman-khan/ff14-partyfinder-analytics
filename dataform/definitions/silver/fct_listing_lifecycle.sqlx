config {
  type: "incremental",
  schema: "silver",
  name: "fct_listing_lifecycle",
  uniqueKey: ["listing_id", "session_start"],
  description: "Accumulating-snapshot fact: ONE ROW PER LISTING SESSION. The 15-min snapshot stream in fct_listings is sessionized via gap-and-islands (a gap > 30 min starts a new session, so an identical re-post weeks later is its own row). Derives lifetime, time-to-fill, fill outcome, and role bottleneck. FILL INFERENCE: a full party (e.g. 8/8) is NEVER scrapeable because the listing delists the instant it completes - slots_filled includes the recruiter and caps at slots_total-1 (7/8). So 'filled' is INFERRED: a multi-snapshot session last seen one short (slots_total-1) that has since disappeared from PF (last_seen precedes the data frontier by > SESSION_GAP_MIN) is treated as filled; time_to_full_min is then its observed lifetime (fill happened just after the last scrape). Sessions still live at the frontier are outcome='live' (unresolved) and get finalized on a later incremental run. CAVEATS: time-to-fill resolution is +/-15 min; a mid-life description edit changes listing_id (sessionization handles re-posts, not edits); single-snapshot 'flash' sessions stay right-censored (post time unknown, fill un-inferable); MULTI-PARTY content (slots_total > 8: alliance raids, Chaotic, PvP custom) only ever exposes the recruiter's own 8-slot party in slot_details while slots_total is a variable alliance-wide counter, so per-party fill is unobservable - these are outcome='multiparty' and excluded from all fill metrics (still counted for activity/volume).",
  bigquery: {
    partitionBy: "first_seen_date",
    clusterBy: ["pf_region", "duty_key", "pf_world_key"],
    updatePartitionFilter: "first_seen_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 4 DAY)"
  },
  assertions: {
    nonNull: ["lifecycle_key", "listing_id", "session_start", "first_seen_date", "duty_key", "pf_world_key", "last_seen"],
    uniqueKey: ["lifecycle_key"],
    rowConditions: [
      "observed_lifetime_min >= 0",
      "n_snapshots >= 1",
      "time_to_full_min IS NULL OR time_to_full_min >= 0",
      "max_slots_filled IS NULL OR slots_total IS NULL OR max_slots_filled <= slots_total",
      "fill_rate_pct IS NULL OR fill_rate_pct BETWEEN 0 AND 100"
    ]
  }
}

WITH snapshots AS (
  SELECT
    listing_id, scraped_at, duty_key, pf_world_key, creator_world_key,
    pf_datacenter, pf_region, creator_datacenter, creator_region,
    is_cross, is_traveller, is_voyager,
    is_practice, is_duty_complete,
    is_loot, is_clear, is_one_per_job,
    is_weekly_unclaimed, is_duty_completion,
    is_duty_incomplete,
    min_ilvl, slots_filled, slots_total,
    open_tank_slots, open_healer_slots, open_dps_slots
  FROM ${ref("fct_listings")}
  WHERE listing_id IS NOT NULL
    ${ when(incremental(),
        `AND scraped_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 3 DAY)`) }
),

-- gap-and-islands: flag a new session when the gap from the prior scrape exceeds SESSION_GAP_MIN
flagged AS (
  SELECT *,
    IF(
      TIMESTAMP_DIFF(
        scraped_at,
        LAG(scraped_at) OVER (PARTITION BY listing_id ORDER BY scraped_at),
        MINUTE
      ) > ${ffxiv.SESSION_GAP_MIN},
      1, 0
    ) AS is_new_session
  FROM snapshots
),

-- running sum of the flag = session group; session_start = first scrape of that group
sessioned AS (
  SELECT *,
    MIN(scraped_at) OVER (PARTITION BY listing_id, session_grp) AS session_start
  FROM (
    SELECT *,
      SUM(is_new_session) OVER (
        PARTITION BY listing_id ORDER BY scraped_at
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
      ) AS session_grp
    FROM flagged
  )
),

-- global data frontier: the latest scrape we hold. A session whose last snapshot predates
-- (frontier - SESSION_GAP_MIN) has been observed to vanish from PF = delisted. We use the
-- DATA frontier, not CURRENT_TIMESTAMP(), because the loader is manual and data can lag hours.
frontier AS (
  SELECT MAX(scraped_at) AS max_scrape FROM snapshots
),

agg AS (
  SELECT
    listing_id,
    session_start,
    DATE(session_start) AS first_seen_date,
    MAX(scraped_at) AS last_seen,
    TIMESTAMP_DIFF(MAX(scraped_at), session_start, MINUTE) AS observed_lifetime_min,
    COUNT(*) AS n_snapshots,

    ANY_VALUE(duty_key) AS duty_key,
    ANY_VALUE(pf_world_key) AS pf_world_key,
    ANY_VALUE(creator_world_key) AS creator_world_key,
    ANY_VALUE(pf_datacenter) AS pf_datacenter,
    ANY_VALUE(pf_region) AS pf_region,
    ANY_VALUE(creator_datacenter) AS creator_datacenter,
    ANY_VALUE(creator_region) AS creator_region,
    MAX(is_cross) AS is_cross,
    MAX(is_traveller) AS is_traveller,
    MAX(is_voyager) AS is_voyager,
    -- intent/description tags are set at post time; MAX = ever tagged during the session
    MAX(is_practice) AS is_practice,
    MAX(is_duty_complete) AS is_duty_complete,
    MAX(is_loot) AS is_loot,
    MAX(is_clear) AS is_clear,
    MAX(is_one_per_job) AS is_one_per_job,
    MAX(is_weekly_unclaimed) AS is_weekly_unclaimed,
    MAX(is_duty_completion) AS is_duty_completion,
    MAX(is_duty_incomplete) AS is_duty_incomplete,
    MAX(min_ilvl) AS min_ilvl,

    MAX(slots_total) AS slots_total,
    MAX(IF(scraped_at = session_start, slots_filled, NULL)) AS initial_slots_filled,
    MAX(slots_filled) AS max_slots_filled,
    -- slots_filled at the last scrape before the listing vanished; drives fill inference
    ARRAY_AGG(slots_filled ORDER BY scraped_at DESC LIMIT 1)[SAFE_OFFSET(0)] AS last_slots_filled,

    AVG(open_tank_slots) AS avg_open_tank,
    AVG(open_healer_slots) AS avg_open_healer,
    AVG(open_dps_slots) AS avg_open_dps
  FROM sessioned
  GROUP BY listing_id, session_start
),

-- fill inference: is_delisted = we have observed the listing disappear from PF.
-- reached_full = multi-snapshot, delisted, last seen one short of full (recruiter + full party).
scored AS (
  SELECT
    agg.*,
    (agg.last_seen < TIMESTAMP_SUB(f.max_scrape, INTERVAL ${ffxiv.SESSION_GAP_MIN} MINUTE)) AS is_delisted,
    CASE
      WHEN agg.slots_total <= 8   -- fill is only observable for single parties (see multiparty note)
       AND agg.n_snapshots > 1
       AND agg.last_seen < TIMESTAMP_SUB(f.max_scrape, INTERVAL ${ffxiv.SESSION_GAP_MIN} MINUTE)
       AND agg.last_slots_filled >= agg.slots_total - 1
      THEN 1 ELSE 0
    END AS reached_full
  FROM agg
  CROSS JOIN frontier f
)

SELECT
  TO_HEX(MD5(CONCAT(s.listing_id, '|', CAST(s.session_start AS STRING)))) AS lifecycle_key,
  s.listing_id,
  s.session_start,
  s.first_seen_date,
  s.last_seen,
  s.observed_lifetime_min,
  s.n_snapshots,

  s.duty_key,
  COALESCE(d.is_high_end, 0) AS is_high_end,
  COALESCE(d.content_category, 'other') AS content_category,
  s.pf_world_key,
  s.creator_world_key,
  s.pf_datacenter,
  s.pf_region,
  s.creator_datacenter,
  s.creator_region,
  s.is_cross,
  s.is_traveller,
  s.is_voyager,
  s.is_practice,
  s.is_duty_complete,
  s.is_loot,
  s.is_clear,
  s.is_one_per_job,
  s.is_weekly_unclaimed,
  s.is_duty_completion,
  s.is_duty_incomplete,
  s.min_ilvl,

  s.slots_total,
  s.initial_slots_filled,
  s.max_slots_filled,
  s.last_slots_filled,
  s.reached_full,
  -- fill lands just after the last one-short scrape, so lifetime approximates time to full
  IF(s.reached_full = 1, s.observed_lifetime_min, NULL) AS time_to_full_min,
  -- relative to fillable slots (slots_total-1 drops the recruiter), so one-short reads as 100%
  LEAST(SAFE_DIVIDE(s.max_slots_filled, NULLIF(s.slots_total - 1, 0)) * 100, 100) AS fill_rate_pct,

  s.avg_open_tank,
  s.avg_open_healer,
  s.avg_open_dps,
  CASE
    WHEN s.avg_open_tank >= s.avg_open_healer AND s.avg_open_tank >= s.avg_open_dps AND s.avg_open_tank > 0 THEN 'tank'
    WHEN s.avg_open_healer >= s.avg_open_dps AND s.avg_open_healer > 0 THEN 'healer'
    WHEN s.avg_open_dps > 0 THEN 'dps'
    ELSE 'none'
  END AS bottleneck_role,

  IF(s.is_delisted, 0, 1) AS is_right_censored,
  CASE
    WHEN s.slots_total > 8 THEN 'multiparty'
    WHEN s.n_snapshots = 1 THEN 'flash'
    WHEN NOT s.is_delisted THEN 'live'
    WHEN s.reached_full = 1 THEN 'filled'
    ELSE 'expired_partial'
  END AS outcome
FROM scored s
LEFT JOIN ${ref("dim_duties")} d ON d.duty_key = s.duty_key
