# Copy this file to secrets.toml (gitignored) for local runs, OR paste this block
# into Streamlit Community Cloud -> app -> Settings -> Secrets.
# Values come from the dashboard-reader service-account key JSON (see README.md).

[gcp_service_account]
type = "service_account"
project_id = "ff14-pf-data"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "dashboard-reader@ff14-pf-data.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
